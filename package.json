{
  "name": "mis130-workshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:production": "node scripts/test-production.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm run test:verification && npm run check:sources && npm run build",
    "prebuild": "node scripts/build-notices.mjs",
    "postbuild": "node scripts/build-manifest.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "check:reproducible": "node scripts/check-reproducible.mjs",
    "test:verification": "node --test scripts/verify-deployment.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "webr": "0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.55.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "vite": "^7.1.0",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "description": "An independent browser-based R practice workshop for MIS 130.",
  "author": "Arda Çeki",
  "license": "MIT"
}
